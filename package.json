{
  "name": "@keshavsoft/api-tree",
  "version": "1.0.0",
  "description": "Build a callable runtime API tree from API paths, source JSON, and an external executor.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/test.js",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/keshavsoft/api-tree.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "api-tree",
    "json-driven",
    "runtime-api",
    "api-paths",
    "declarative-api"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.10"
  }
}
